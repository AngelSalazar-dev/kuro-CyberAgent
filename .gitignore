# Python bytecode
__pycache__/
*.py[cod]

# Packaging / build artifacts
*.egg-info/
build/
dist/

# Virtualenvs — the user brings their own
.venv/
venv/

# Credential profiles. Token Juice's is personal and must never be committed;
# its `*.example` beside it is the committable template. Logfare's is the
# deliberate exception — a shared key shipped so a fresh clone can start, and
# re-included below — because the whole point of it is that every new install
# has one.
packaging/*/source
!packaging/logfare/source

# JS / Rust build artifacts (target/ alone is ~3.7 GB of Rust cache)
node_modules/
target/
.next/

