# Python bytecode
__pycache__/
*.py[cod]

# Packaging / build artifacts
*.egg-info/
build/
dist/

# Virtualenvs — the user brings their own
.venv/
venv/

# Credential profiles. These hold a live upstream key and must never be
# committed — the `*.example` file beside each one is the committable template.
# setup.sh writes the real file into ~/.zimzilla/<route>/source with mode 600,
# so a clone needs no profile in-tree to work.
packaging/*/source

