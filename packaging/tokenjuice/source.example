# Kuro â€” Token Juice profile
#
# This file is the credential profile for the Token Juice route. Copy it to
# `source` beside this example and put your key in â€” setup.sh does that for you
# when $ANTHROPIC_AUTH_TOKEN already holds a tj_ key, and writes it mode 600.
#
# `source` is gitignored; only this template is committed. A `source` file was
# committed here once, carrying a live key, which is why the route now reports
# itself unavailable rather than shipping a working profile.
#
# Token Juice keys start with `tj_`. The same key is the bearer token Kuro
# sends and the upstream OpenAI key LiteLLM forwards.

export ANTHROPIC_BASE_URL="http://localhost:4000"
export ANTHROPIC_AUTH_TOKEN="tj_REPLACE_ME"
export ANTHROPIC_MODEL="deepseek-v4.1-flash"

# Load-bearing: an empty string keeps ANTHROPIC_AUTH_TOKEN authoritative and
# clears any real API key inherited from the shell.
export ANTHROPIC_API_KEY=""

# Token Juice serves exactly one chat model, so there is nothing to alias.
export MODEL_DEFAULT="deepseek-v4.1-flash"

